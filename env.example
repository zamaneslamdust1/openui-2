# ============================================================
# VodiWalker — Environment Variables (Render Ready)
# این فایل رو به اسم .env کپی کن یا مقادیر رو مستقیم توی
# داشبورد Render → Environment بذار
# ============================================================

# ── اجباری ─────────────────────────────────────────────────
# نام کاربری و رمز ورود پنل (حتماً عوضشون کن!)
ADMIN_USERNAME=VodiAdmin
ADMIN_PASSWORD=change-me-now

# کلید رمزنگاری — روی Render از generateValue استفاده کن،
# یا یه رشته تصادفی طولانی اینجا بذار (خالی = خودکار ساخته میشه ولی با ری‌استارت پلن Free عوض میشه)
SECRET_KEY=

# ── پورت ───────────────────────────────────────────────────
# روی Render خودش ست میشه، دست نزن
PORT=8000

# ── ذخیره‌سازی داده ────────────────────────────────────────
# پلن Free: خالی بمونه (داده‌ها موقتی‌ان)
# پلن پولی با Disk: مسیر mount دیسک، مثلاً /var/data
DATA_DIR=

# ── آدرس عمومی پنل ─────────────────────────────────────────
# بعد از اولین دیپلوی، دامنه‌ای که Render میده رو بذار
# مثال: https://vodiwalker-panel.onrender.com
# (روی Render معمولاً لازم نیست چون RENDER_EXTERNAL_URL خودکار ست میشه)
PUBLIC_BASE_URL=

# ── TCP Relay (مخصوص Railway) ──────────────────────────────
# روی Render پورت TCP جداگانه در دسترس نیست → خالی بمونه
TCP_PUBLIC_HOST=
TCP_PUBLIC_PORT=

# ── ربات تلگرام (اختیاری) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_BOT_USERNAME=VodiWalkerBot

# ── CORS (اختیاری) ─────────────────────────────────────────
# اگه دامنه اختصاصی داری، با کاما جدا کن
CORS_ALLOWED_ORIGINS=
